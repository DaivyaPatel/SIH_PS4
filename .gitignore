# Executable synthetic test fixtures remain tracked.
/research-downloads/
/regulatory-cache/
/review-exports/

# Offline fixture validation output and future local test caches
/fixture-results/
.pytest_cache/
.ruff_cache/

# Local benchmark runs and consented participant-study data
